{
  "expo": {
    "name": "SpotifyMini",
    "slug": "spotifyMini",
    "scheme": "spotifymini",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "permissions": [
        "FOREGROUND_SERVICE",
        "WAKE_LOCK"
      ],
      "package": "com.spotifymini.app"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
